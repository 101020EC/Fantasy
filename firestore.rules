rules_version = '2';

// Fanta เขียน Firestore ผ่าน Admin SDK ใน POST /api/archive เท่านั้น
// Admin SDK ใช้ service account จึงข้าม rules ชุดนี้ไปโดยสิ้นเชิง
// ดังนั้นปฏิเสธ client ทุกรายได้อย่างปลอดภัย — browser ไม่เคยต่อ Firestore ตรงๆ
//
// deploy: วางเนื้อหาไฟล์นี้ใน Firebase Console > Firestore Database > Rules > Publish

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
