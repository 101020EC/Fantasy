# ═══════════════════════════════════════════════════════════
# Access password  (H5)
# ═══════════════════════════════════════════════════════════
# ตั้งค่านี้แล้ว middleware.ts จะกันทุกหน้าและทุก /api/* ไว้หลัง session cookie
# ถ้าไม่ตั้ง = เปิดสาธารณะโดยตั้งใจ (ไม่มีหน้า login)
APP_PASSWORD=
# ไม่บังคับ: ใช้เซ็นชื่อ session แยกจากรหัสผ่าน (ถ้าไม่ตั้งจะใช้ APP_PASSWORD)
SESSION_SECRET=

# ═══════════════════════════════════════════════════════════
# Firebase  (ฝั่งเซิร์ฟเวอร์เท่านั้น — H4)
# ═══════════════════════════════════════════════════════════
# แอปเขียน Firestore ผ่าน Admin SDK ใน POST /api/archive
# browser ไม่ต่อ Firestore โดยตรง จึงไม่มีตัวแปร NEXT_PUBLIC_FIREBASE_* อีกต่อไป
#
# สร้างจาก: Firebase Console > Project settings > Service accounts
#           > Generate new private key  (ได้ไฟล์ .json)
# แล้วแปลงเป็น base64:
#   base64 -i ~/Downloads/ชื่อไฟล์.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT=

# ═══════════════════════════════════════════════════════════
# Telegram price alerts  (H2, H3, H6)
# ═══════════════════════════════════════════════════════════
# ตั้งค่าได้ในเว็บแล้ว (เมนู > Alert) ซึ่งเก็บลง Firestore และมีผลทันทีโดยไม่ต้อง redeploy
# ตัวแปรข้างล่างเหลือไว้เป็น fallback สำหรับ deploy ที่ยังไม่เคยตั้งค่าผ่านหน้าเว็บ
# 1. คุยกับ @BotFather เพื่อสร้าง bot และเอา token
# 2. กด /start กับ bot แล้วคุยกับ @userinfobot เพื่อเอา chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TEAM_ID=

# ป้องกัน /api/cron/price-alert — Vercel Cron ส่งค่านี้มาเป็น Bearer token
# สร้างด้วย: openssl rand -hex 32
CRON_SECRET=
